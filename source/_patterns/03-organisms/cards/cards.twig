o{#
/**
 * Available variables:
 * - cards - primary variable
 *   - background: background color [default, alt]
 *   - num_cols: the number of columns at desktop widths [1, 2-50-50, 2-60-40, 2-75-25, 3, 4]
 *   - heading: the heading (title & lead)
 *   - items: array of card items
 *   - link: link/button
 *     - url: link url
 *     - text: link text
 *   - classes: array of classes to add to component
 */
#}

{% set tag = cards.heading.title is empty ? 'h2' : 'h3' %}

{% set classes = [
  'jcc-cards',
  'jcc-cards--' ~ cards.num_cols|default('3') ~ '-cols',
]|merge(cards.classes|default([])) %}

{% import _self as sections %}

{% macro section(classes, cards, default_heading_tag) %}
  {% if cards.items is not empty %}
  <ul class="{{ classes|join(' ')|trim }}">
    {% for item in cards.items %}
      {# Prefer explicit item tag; otherwise use section default. #}
      {% set item_heading_tag = item.card_title_tag|default(item.title_tag|default(default_heading_tag)) %}
      {% set item = item|merge({ card_title_tag: item_heading_tag, title_tag: item_heading_tag }) %}
      <li class="jcc-cards__item">
        {% include "@molecules/card/card.twig" with {
          card: item
        } %}
      </li>
    {% endfor %}
  </ul>
  {% endif %}

  {% if cards.link.url %}
    {% if cards.link.aria_label %}
      {% set attributes %}
        aria-label="{{ cards.link.aria_label }}"
      {% endset %}
    {% endif %}
    <div class="jcc-cards__link{{ cards.link.align == 'left' ? ' jcc-cards__link-left' : '' }}">
      <a href="{{ cards.link.url }}" {{ attributes }}>{{ cards.link.text }}</a>
    </div>
  {% endif %}
{% endmacro %}

{% if cards.no_container %}
  {{ sections.section(classes, cards, tag) }}
{% else %}
  {% set content %}
    {{ sections.section(classes, cards, tag) }}
  {% endset %}

  {% include "@molecules/section/section.twig" with {
    section: {
      heading: cards.heading,
      content: content,
      background: cards.background|default('default'),
      spacing: cards.spacing|default('default'),
    }
  } %}
{% endif %}
